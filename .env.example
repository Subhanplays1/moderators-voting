# ========================================
# MODERATORS - Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ========================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/moderators?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars-long-change-this"
JWT_EXPIRES_IN="7d"

# Encryption (for stored tokens/credentials)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-change-this"

# Server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# Instagram Provider (mock | production)
INSTAGRAM_PROVIDER="mock"

# Instagram Graph API (only needed for production provider)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (for invitations - optional in development)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Storage (for screenshots)
STORAGE_PROVIDER="local"
STORAGE_PATH="./uploads"
# S3-compatible (optional)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
